    affiliation: Lancaster University
version: 0.1.0
license: MIT
repository-code: "https://github.com/FlowInference/flow-inference"
keywords:
  - gaussian processes
  - stochastic differential equations
  - diffusion models
  - flow matching
  - guidance
  - conditional sampling
